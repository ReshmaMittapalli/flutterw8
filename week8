
import 'package:flutter/material.dart';

void main() {
  runApp(const AnimationDemoApp());
}

class AnimationDemoApp extends StatelessWidget {
  const AnimationDemoApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Animations Demo',
      theme: ThemeData(
        useMaterial3: true,
        colorScheme: ColorScheme.fromSeed(
          seedColor: Colors.deepPurple,
        ),
        scaffoldBackgroundColor: const Color(0xFFF5F3FA),
      ),
      home: const AnimationScreen(),
    );
  }
}

class AnimationScreen extends StatefulWidget {
  const AnimationScreen({super.key});

  @override
  State<AnimationScreen> createState() => _AnimationScreenState();
}

class _AnimationScreenState extends State<AnimationScreen>
    with TickerProviderStateMixin {
  late final AnimationController _fadeController;
  late final AnimationController _slideController;
  late final AnimationController _scaleController;
  late final AnimationController _rotationController;
  late final AnimationController _combinedController;

  late final Animation<double> _fadeAnimation;
  late final Animation<Offset> _slideAnimation;
  late final Animation<double> _scaleAnimation;
  late final Animation<double> _rotationAnimation;
  late final Animation<double> _combinedFade;
  late final Animation<Offset> _combinedSlide;

  bool _fadeVisible = true;

  @override
  void initState() {
    super.initState();

    _fadeController = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 900),
      value: 0,
    );

    _fadeAnimation = CurvedAnimation(
      parent: _fadeController,
      curve: Curves.easeIn,
    );

    _slideController = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 800),
    );

    _slideAnimation = Tween<Offset>(
      begin: const Offset(-1.2, 0),
      end: Offset.zero,
    ).animate(
      CurvedAnimation(
        parent: _slideController,
        curve: Curves.easeOutCubic,
      ),
    );

    _scaleController = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 600),
    );

    _scaleAnimation = Tween<double>(
      begin: 1,
      end: 1.35,
    ).animate(
      CurvedAnimation(
        parent: _scaleController,
        curve: Curves.elasticOut,
      ),
    );

    _rotationController = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 1000),
    );

    _rotationAnimation = Tween<double>(
      begin: 0,
      end: 1,
    ).animate(_rotationController);

    _combinedController = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 1000),
    );

    _combinedFade = CurvedAnimation(
      parent: _combinedController,
      curve: Curves.easeIn,
    );

    _combinedSlide = Tween<Offset>(
      begin: const Offset(0, 0.8),
      end: Offset.zero,
    ).animate(
      CurvedAnimation(
        parent: _combinedController,
        curve: Curves.easeOutCubic,
      ),
    );

    _fadeController.forward();
  }

  void _toggleFade() {
    setState(() {
      _fadeVisible = !_fadeVisible;
    });

    if (_fadeVisible) {
      _fadeController.forward();
    } else {
      _fadeController.reverse();
    }
  }

  void _playSlide() {
    _slideController.forward(from: 0);
  }

  void _playScale() {
    _scaleController.forward(from: 0).then((_) {
      if (mounted) {
        _scaleController.reverse();
      }
    });
  }

  void _playRotation() {
    _rotationController.forward(from: 0);
  }

  void _playCombined() {
    _combinedController.forward(from: 0);
  }

  void _resetAll() {
    _fadeController.reset();
    _slideController.reset();
    _scaleController.reset();
    _rotationController.reset();
    _combinedController.reset();

    setState(() {
      _fadeVisible = true;
    });

    _fadeController.forward();
  }

  @override
  void dispose() {
    _fadeController.dispose();
    _slideController.dispose();
    _scaleController.dispose();
    _rotationController.dispose();
    _combinedController.dispose();
    super.dispose();
  }

  Widget _animationCard({
    required String title,
    required String subtitle,
    required IconData icon,
    required Color color,
    required Widget child,
  }) {
    return Card(
      elevation: 3,
      color: Colors.white,
      shape: RoundedRectangleBorder(
        borderRadius: BorderRadius.circular(18),
      ),
      clipBehavior: Clip.none,
      child: Padding(
        padding: const EdgeInsets.all(14),
        child: Row(
          children: [
            SizedBox(
              width: 90,
              height: 85,
              child: Center(child: child),
            ),
            const SizedBox(width: 14),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Text(
                    title,
                    style: const TextStyle(
                      fontSize: 17,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                  const SizedBox(height: 5),
                  Text(
                    subtitle,
                    style: const TextStyle(
                      color: Colors.black54,
                      fontSize: 12,
                    ),
                  ),
                ],
              ),
            ),
            Icon(icon, color: color, size: 25),
          ],
        ),
      ),
    );
  }

  Widget _demoIcon(Color color, IconData icon) {
    return Container(
      width: 58,
      height: 58,
      decoration: BoxDecoration(
        color: color.withAlpha(30),
        borderRadius: BorderRadius.circular(16),
      ),
      child: Icon(icon, size: 34, color: color),
    );
  }

  Widget _actionButton(String label, VoidCallback onPressed) {
    return SizedBox(
      height: 42,
      child: ElevatedButton(
        onPressed: onPressed,
        style: ElevatedButton.styleFrom(
          backgroundColor: Colors.deepPurple,
          foregroundColor: Colors.white,
          padding: const EdgeInsets.symmetric(horizontal: 12),
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(12),
          ),
        ),
        child: Text(label),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text(
          'Animations Demo',
          style: TextStyle(fontWeight: FontWeight.bold),
        ),
        centerTitle: true,
        backgroundColor: Colors.deepPurple,
        foregroundColor: Colors.white,
      ),
      body: SafeArea(
        child: SingleChildScrollView(
          padding: const EdgeInsets.all(16),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: [
              const Text(
                'Explore Flutter Animations',
                style: TextStyle(
                  fontSize: 23,
                  fontWeight: FontWeight.bold,
                  color: Colors.deepPurple,
                ),
              ),
              const SizedBox(height: 6),
              const Text(
                'Tap the buttons to see each animation in action.',
                style: TextStyle(color: Colors.black54),
              ),
              const SizedBox(height: 20),

              // 1. FADE ANIMATION
              _animationCard(
                title: 'Fade Animation',
                subtitle: 'Fade the card in and out.',
                icon: Icons.opacity,
                color: Colors.blue,
                child: FadeTransition(
                  opacity: _fadeAnimation,
                  child: _demoIcon(
                    Colors.blue,
                    Icons.visibility,
                  ),
                ),
              ),
              Align(
                alignment: Alignment.centerRight,
                child: _actionButton(
                  _fadeVisible ? 'Fade Out' : 'Fade In',
                  _toggleFade,
                ),
              ),
              const SizedBox(height: 12),

              // 2. SLIDE ANIMATION
              _animationCard(
                title: 'Slide Animation',
                subtitle: 'Slide in from the left.',
                icon: Icons.swipe,
                color: Colors.orange,
                child: SlideTransition(
                  position: _slideAnimation,
                  child: _demoIcon(
                    Colors.orange,
                    Icons.arrow_forward,
                  ),
                ),
              ),
              Align(
                alignment: Alignment.centerRight,
                child: _actionButton('Slide In', _playSlide),
              ),
              const SizedBox(height: 12),

              // 3. SCALE ANIMATION
              _animationCard(
                title: 'Scale Animation',
                subtitle: 'Bounce when tapped.',
                icon: Icons.zoom_in,
                color: Colors.green,
                child: ScaleTransition(
                  scale: _scaleAnimation,
                  child: GestureDetector(
                    onTap: _playScale,
                    child: _demoIcon(
                      Colors.green,
                      Icons.touch_app,
                    ),
                  ),
                ),
              ),
              const SizedBox(height: 12),

              // 4. ROTATION ANIMATION
              _animationCard(
                title: 'Rotation Animation',
                subtitle: 'Rotate a full 360 degrees.',
                icon: Icons.refresh,
                color: Colors.purple,
                child: RotationTransition(
                  turns: _rotationAnimation,
                  child: _demoIcon(
                    Colors.purple,
                    Icons.settings,
                  ),
                ),
              ),
              Align(
                alignment: Alignment.centerRight,
                child: _actionButton('Rotate', _playRotation),
              ),
              const SizedBox(height: 12),

              // 5. COMBINED ANIMATION
              _animationCard(
                title: 'Combined Animation',
                subtitle: 'Fade and slide together.',
                icon: Icons.auto_awesome,
                color: Colors.pink,
                child: SlideTransition(
                  position: _combinedSlide,
                  child: FadeTransition(
                    opacity: _combinedFade,
                    child: _demoIcon(
                      Colors.pink,
                      Icons.auto_awesome,
                    ),
                  ),
                ),
              ),
              Align(
                alignment: Alignment.centerRight,
                child: _actionButton(
                  'Play Combined',
                  _playCombined,
                ),
              ),

              const SizedBox(height: 24),

              SizedBox(
                height: 52,
                child: OutlinedButton.icon(
                  onPressed: _resetAll,
                  icon: const Icon(Icons.restart_alt),
                  label: const Text(
                    'Reset All Animations',
                    style: TextStyle(
                      fontSize: 16,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                  style: OutlinedButton.styleFrom(
                    foregroundColor: Colors.deepPurple,
                    side: const BorderSide(
                      color: Colors.deepPurple,
                    ),
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(14),
                    ),
                  ),
                ),
              ),
              const SizedBox(height: 16),
              const Center(
                child: Text(
                  'Flutter Animation Framework',
                  style: TextStyle(color: Colors.black45),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}
